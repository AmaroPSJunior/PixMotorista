rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isDriverIdentity() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email != null;
    }

    function ownsPassengerDocument() {
      return signedIn()
        && ('authUid' in resource.data)
        && resource.data.authUid == request.auth.uid;
    }

    function ownsRide(rideId) {
      return isDriverIdentity()
        && exists(/databases/$(database)/documents/rides/$(rideId))
        && get(/databases/$(database)/documents/rides/$(rideId)).data.driverUid == request.auth.uid;
    }

    function rideIsActive(rideId) {
      return exists(/databases/$(database)/documents/rides/$(rideId))
        && get(/databases/$(database)/documents/rides/$(rideId)).data.status == 'active';
    }

    match /driver_profiles/{documentId} {
      allow read: if documentId == 'main_profile'
        || (signedIn() && resource.data.authUid == request.auth.uid);

      allow create: if isDriverIdentity()
        && request.resource.data.authUid == request.auth.uid;

      allow update: if isDriverIdentity()
        && request.resource.data.authUid == request.auth.uid
        && (
          resource.data.authUid == request.auth.uid
          || (
            !('authUid' in resource.data)
            && ('googleEmail' in resource.data)
            && resource.data.googleEmail == request.auth.token.email
          )
        );

      allow delete: if isDriverIdentity()
        && resource.data.authUid == request.auth.uid;
    }

    match /rides/{rideId} {
      allow read: if signedIn()
        && (
          resource.data.driverUid == request.auth.uid
          || resource.data.status == 'active'
        );

      allow create: if isDriverIdentity()
        && request.resource.data.driverUid == request.auth.uid;

      allow update, delete: if isDriverIdentity()
        && resource.data.driverUid == request.auth.uid
        && request.resource.data.driverUid == request.auth.uid;
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isDriverIdentity();
    }

    match /session_settings/{documentId} {
      allow read: if true;
      allow write: if isDriverIdentity();
    }

    match /passenger_sessions/{sessionId} {
      allow read: if signedIn()
        && (
          ownsPassengerDocument()
          || (('driverUid' in resource.data) && resource.data.driverUid == request.auth.uid)
        );

      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.authUid == request.auth.uid
        && ('rideId' in request.resource.data)
        && ('driverUid' in request.resource.data)
        && ('unlockedServices' in request.resource.data)
        && ('ridePrice' in request.resource.data)
        && rideIsActive(request.resource.data.rideId)
        && get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.driverUid
          == request.resource.data.driverUid
        && request.resource.data.unlockedServices
          == get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.defaultUnlockedServices
        && request.resource.data.ridePrice
          == get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.price;

      allow update: if (
          ownsPassengerDocument()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.rideId == resource.data.rideId
          && request.resource.data.driverUid == resource.data.driverUid
          && rideIsActive(resource.data.rideId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'passengerName',
            'lastActiveAt',
            'browserId'
          ])
        )
        || (
          isDriverIdentity()
          && ('driverUid' in resource.data)
          && resource.data.driverUid == request.auth.uid
        );

      allow delete: if ownsPassengerDocument()
        || (
          isDriverIdentity()
          && ('driverUid' in resource.data)
          && resource.data.driverUid == request.auth.uid
        );
    }

    match /spotify_sessions/{document=**} {
      allow read, write: if false;
    }

    match /pix_payments/{document=**} {
      allow read, write: if false;
    }

    match /mercadopago_config/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
